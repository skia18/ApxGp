{
  "name": "ApxGp",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,backend,racecar --prefix-colors cyan,green,magenta \"npm:frontend:dev\" \"npm:backend:dev\" \"npm:racecar:dev\"",
    "build": "npm run frontend:build",
    "lint": "npm run frontend:lint && npm run backend:format:check",
    "typecheck": "npm run frontend:typecheck",
    "format": "npm run frontend:format && npm run backend:format",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:dev": "vite dev",
    "frontend:build": "vite build",
    "frontend:build:dev": "vite build --mode development",
    "frontend:preview": "vite preview",
    "frontend:lint": "eslint .",
    "frontend:typecheck": "tsc --noEmit",
    "frontend:format": "prettier --write .",
    "frontend:test": "vitest run",
    "frontend:test:watch": "vitest",
    "api:types": "openapi-typescript backend/apispec/openapi.yaml -o src/api/schema.d.ts",
    "backend:dev": "set -a && . ./backend/.env.local && set +a && cd backend && go run ./cmd/api",
    "backend:format": "gofmt -w backend",
    "backend:format:check": "test -z \"$(gofmt -l backend)\"",
    "backend:test": "cd backend && go test ./...",
    "racecar:dev": "PORT=3002 node node_modules/f1-livetiming-api/src/server.js",
    "database:start": "supabase start",
    "database:stop": "supabase stop",
    "database:reset": "supabase db reset",
    "database:status": "supabase status"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "f1-livetiming-api": "github:julesr0y/f1-livetiming-api#76512d8c0124acd21e499ef924363e1dbdd825b4",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.27.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "nitro": "3.0.260603-beta",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.3",
    "supabase": "^2.122.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
