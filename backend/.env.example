export APEX_ENV=development
export APEX_HTTP_ADDR=:8081
export APEX_DATABASE_URL='postgresql://postgres:password@localhost:5432/postgres?sslmode=disable'
# Development accepts browser requests from localhost and LAN addresses by default.
# In production, set this to the exact Vercel domain(s), separated by commas.
export APEX_CORS_ALLOWED_ORIGINS=*
export APEX_HTTP_TIMEOUT=10s
export APEX_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
export APEX_CURRENT_SEASON=2026
